# ─────────────────────────────────────────────────────────────────────────────
#  Fair Together — Agent System Environment Variables
#  Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/fair_together"

# ── Anthropic (used by Extraction Agent + Push Agent for AI insights) ─────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── PDF Storage ───────────────────────────────────────────────────────────────
# Local path for dev, S3/GCS path for production
PDF_STORAGE_PATH="/tmp/fair-together-pdfs"

# ── GitHub Actions (Orchestrator triggers) ────────────────────────────────────
# A random secret — GitHub Actions sends this header, server checks it
CRON_SECRET="generate-a-long-random-string-here"

# ── Expo (Push notifications) ─────────────────────────────────────────────────
EXPO_ACCESS_TOKEN="your-expo-access-token"

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="generate-a-long-random-string-here"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
API_BASE_URL="https://api.fairtogether.co.il"
